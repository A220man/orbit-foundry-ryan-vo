# App
APP_NAME=Orbit Foundry
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./orbit_foundry.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak / OIDC
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/orbit-foundry
OIDC_CLIENT_ID=orbit-foundry-frontend
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Demo mode (local only)
DEMO_MODE=true

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1